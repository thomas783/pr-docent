{
  "name": "pr-docent",
  "version": "0.2.3",
  "type": "module",
  "description": "Guided, narrated review tours on top of GitHub pull request diffs. This package installs the local tour generator for the PR Docent Chrome extension.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomas783/pr-docent.git"
  },
  "homepage": "https://github.com/thomas783/pr-docent#readme",
  "keywords": [
    "github",
    "pull-request",
    "code-review",
    "chrome-extension",
    "claude"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "pr-docent": "bin/pr-docent.mjs"
  },
  "files": [
    "bin/",
    "host/",
    "src/diff.js",
    "src/guidelines.js",
    "src/short.js",
    "src/short-scenes.js",
    "src/tour.js",
    "scripts/check-short.mjs",
    "scripts/check-tour.mjs",
    "scripts/short-prompt.md",
    "scripts/tour-prompt.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "install-host": "node bin/pr-docent.mjs install",
    "package": "node scripts/package-extension.mjs"
  }
}
